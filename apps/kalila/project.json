{
  "root": "apps/kalila",
  "sourceRoot": "apps/kalila",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "root": "apps/kalila",
        "outputPath": "dist/apps/kalila"
      },
      "configurations": {
        "production": {}
      }
    },
    "serve": {
      "executor": "@nrwl/next:server",
      "options": {
        "buildTarget": "kalila:build",
        "dev": true,
        "buildLibsFromSource": true,
        "port": 6000,
        "hostname": "0.0.0.0"
      },
      "configurations": {
        "production": {
          "buildTarget": "kalila:build:production",
          "dev": false,
          "buildLibsFromSource": true
        }
      }
    },
    "export": {
      "executor": "@nrwl/next:export",
      "options": {
        "buildTarget": "kalila:build:production"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": [
        "coverage/apps/kalila"
      ],
      "options": {
        "jestConfig": "apps/kalila/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/kalila/**/*.{ts,tsx,js,jsx}"
        ]
      }
    }
  },
  "tags": []
}
