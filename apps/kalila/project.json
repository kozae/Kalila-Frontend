{
  "root": "apps/kalila",
  "sourceRoot": "apps/kalila",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "root": "apps/kalila",
        "outputPath": "dist/apps/kalila"
      },
      "configurations": {
        "production": {},
        "development": {}
      }
    },
    "serve": {
      "executor": "@nrwl/next:server",
      "options": {
        "buildTarget": "kalila:build",
        "dev": true,
        "port": 6000,
        "hostname": "0.0.0.0"
      },
      "configurations": {
        "production": {
          "buildTarget": "kalila:build:production",
          "nextConfig": "apps/kalila/next.config.js",
          "dev": false,
          "buildLibsFromSource": true
        },
        "development": {
          "buildTarget": "kalila:build:development",
          "dev": true,
          "buildLibsFromSource": true
        }
      },
      "defaultConfiguration": "development"
    },
    "export": {
      "executor": "@nrwl/next:export",
      "options": {
        "buildTarget": "kalila:build:production"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/apps/kalila"],
      "options": {
        "jestConfig": "apps/kalila/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/kalila/**/*.{ts,tsx,js,jsx}"]
      }
    }
  },
  "tags": []
}
