    "version": "2.0.0",
    "grunt.autoDetect": "off",
    "gulp.autoDetect": "off",
    "jake.autoDetect": "off",
    "npm.autoDetect": "off",
    "typescript.tsc.autoDetect": "off",
    "tasks": [
        {
            "label": "Logs: Dev Server",
            "type": "shell",
            "command": "journalctl -u Kalila.Web.Dev -f",
            "problemMatcher": []
        },
        {
            "label": "Start: Dev Server",
            "type": "shell",
            "command": "systemctl start  Kalila.Web.Dev",
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}