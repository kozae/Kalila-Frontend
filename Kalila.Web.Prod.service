[Unit]
Description=Kalila Web Prod

[Service]
WorkingDirectory=/root/Kalila/next/frontend
ExecStart=/usr/bin/nx run kalila:serve:production --port=6666 --verbose
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=Kalila.Web.Prod
User=root
Environment=NEXT_PUBLIC_SIGNALR_URL=https://kalila-realtime.kozae.de/hub
Environment=NEXT_PUBLIC_API_URL=https://kalila-api.kozae.de/v1/
Environment=NEXT_PUBLIC_IMAGE_URL=/pages/
Environment=NEXT_PUBLIC_PAGES_IMAGE_FOLDER=/root/Kalila/next/frontend/apps/kalila/public/pages/
Environment=NEXT_PUBLIC_PAGES_IMAGE_SEVER=https://static.kozae.de/pages/

Environment=AUTH0_SECRET='e5e66f884ea93a8d3db939b2efae738f7dbbc9aa625152dd1da1b658745b633f'
Environment=AUTH0_BASE_URL='https://kalila.kozae.de/'
Environment=AUTH0_ISSUER_BASE_URL='https://dev-yirbchaj.us.auth0.com'
Environment=AUTH0_TOKEN_ENDPOINT='https://dev-yirbchaj.us.auth0.com/oauth/token'
Environment=AUTH0_CLIENT_ID='8m9YtxdFBaXvXm8s9Lk4AHE0AqeUnrr7'
