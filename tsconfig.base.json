{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2017",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "typeRoots": [
      "src",
      "node_modules/@types"
    ],
    "paths": {
      "@frontend/domain": [
        "libs/domain/src/index.ts"
      ],
      "@frontend/kalila/components": [
        "libs/kalila/components/src/index.ts"
      ],
      "@frontend/kalila/rest": [
        "libs/kalila/rest/src/index.ts"
      ],
      "@frontend/kalila/store": [
        "libs/kalila/store/src/index.ts"
      ],
      "@frontend/server-side-queries": [
        "libs/server-side-queries/src/index.ts"
      ],
      "@frontend/shared-ui": [
        "libs/ui/shared/src/index.ts"
      ],
      "@frontend/ui/administration": [
        "libs/ui/administration/src/index.ts"
      ],
      "@frontend/ui/book-analysis/book-unit-administration": [
        "libs/ui/book-analysis/book-unit-administration/src/index.ts"
      ],
      "@frontend/ui/documents-detailed-view": [
        "libs/ui/documents-detailed-view/src/index.ts"
      ],
      "@frontend/ui/editions": [
        "libs/ui/editions/src/index.ts"
      ],
      "@frontend/ui/facsimile": [
        "libs/ui/facsimile/src/index.ts"
      ],
      "@frontend/ui/facsimile-cropper": [
        "libs/ui/facsimile-cropper/src/index.ts"
      ],
      "@frontend/ui/facsimile-generator": [
        "libs/ui/facsimile-generator/src/index.ts"
      ],
      "@frontend/ui/facsimile-highlighter": [
        "libs/ui/facsimile-highlighter/src/index.ts"
      ],
      "@frontend/ui/facsimile-line-detector": [
        "libs/ui/facsimile-line-detector/src/index.ts"
      ],
      "@frontend/ui/forms": [
        "libs/ui/forms/src/index.ts"
      ],
      "@frontend/ui/layout": [
        "libs/ui/layout/src/index.ts"
      ],
      "@frontend/ui/table": [
