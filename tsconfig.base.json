{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "typeRoots": ["src", "node_modules/@types"],
    "paths": {
      "@frontend/domain": ["libs/domain/src/index.ts"],
      "@frontend/server-side-queries": [
        "libs/server-side-queries/src/index.ts"
      ],
      "@frontend/shared-ui": ["libs/ui/shared/src/index.ts"],
      "@frontend/ui/administration": ["libs/ui/administration/src/index.ts"],
      "@frontend/ui/documents-detailed-view": [
        "libs/ui/documents-detailed-view/src/index.ts"
      ],
      "@frontend/ui/forms": ["libs/ui/forms/src/index.ts"],
      "@frontend/ui/table": ["libs/ui/table/src/index.ts"],
      "@frontend/util": ["libs/util/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
